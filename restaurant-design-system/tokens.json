{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "第28區中餐廳訂位系統 — Design Tokens。格式：W3C Design Tokens (DTCG)。分兩層：primitive（原始調色盤，勿直接用於畫面）與 semantic（依用途命名，工程師實作只用這層）。來源 Figma：Restaurant Reservation system / node 541-2572。RWD 相關 token（斷點、容器寬、版位）暫不納入，待 RWD 定案再補。",

  "primitive": {
    "$description": "第一層：原始值。命名 {色相}-{明度階}。只被 semantic 參照，不直接用於畫面。",
    "color": {
      "gold": {
        "400": { "$type": "color", "$value": "#E4A93C", "$description": "金色-亮，強調文字/漸層亮端" },
        "500": { "$type": "color", "$value": "#C9922A", "$description": "金色-主，品牌主色" }
      },
      "cream": {
        "50":  { "$type": "color", "$value": "#F5F0E8", "$description": "米白，深色底主要文字" },
        "200": { "$type": "color", "$value": "#C8BFB0", "$description": "米灰，次要/連結文字" }
      },
      "taupe": {
        "400": { "$type": "color", "$value": "#9A8C7E", "$description": "灰褐，輔助/說明文字" }
      },
      "ink": {
        "900": { "$type": "color", "$value": "#0A0A0A", "$description": "近黑，App 底色 / 金按鈕上的文字" },
        "950": { "$type": "color", "$value": "#0A0806", "$description": "純黑偏暖，卡片/頁首半透明底的基底色" }
      },
      "white": { "$type": "color", "$value": "#FFFFFF", "$description": "純白，Hero 標題 / 頁尾標語" },
      "green": {
        "400": { "$type": "color", "$value": "#4ADE80", "$description": "成功狀態文字" },
        "500": { "$type": "color", "$value": "#22C55E", "$description": "成功狀態邊框基底" },
        "800": { "$type": "color", "$value": "#166534", "$description": "成功狀態底色基底" }
      },
      "red": {
        "600": { "$type": "color", "$value": "#C03A2B", "$description": "危險/客滿狀態" }
      }
    }
  },

  "color": {
    "$description": "第二層：語意色。命名 {類別}-{用途}-{變體}。工程師實作請只用這層。含 alpha 者以 8 碼 hex 表示。",

    "bg": {
      "base":          { "$type": "color", "$value": "#0A0A0A", "$description": "頁面最底層底色（App 背景）" },
      "surface":       { "$type": "color", "$value": "#0A0806D6", "$description": "卡片/面板底，rgba(10,8,6,0.84)" },
      "surface-strong":{ "$type": "color", "$value": "#0A0806E0", "$description": "頁首底，rgba(10,8,6,0.88)" },
      "footer":        { "$type": "color", "$value": "#000000B8", "$description": "頁尾底，rgba(0,0,0,0.72)" },
      "subtle":        { "$type": "color", "$value": "#FFFFFF0D", "$description": "淺層填色（未選時段/stepper 外框內底），rgba(255,255,255,0.05)" },
      "input":         { "$type": "color", "$value": "#FFFFFF0F", "$description": "輸入框/stepper 按鈕底，rgba(255,255,255,0.06)" },
      "gold-tint":     { "$type": "color", "$value": "#C9922A26", "$description": "金色淺底 chip/badge，rgba(201,146,42,0.15)" },
      "gold-tint-weak":{ "$type": "color", "$value": "#C9922A14", "$description": "金色更淺底 notice，rgba(201,146,42,0.08)" }
    },

    "text": {
      "primary":     { "$type": "color", "$value": "#F5F0E8", "$description": "主要文字（深色底）" },
      "secondary":   { "$type": "color", "$value": "#F5F0E8BF", "$description": "次要文字，rgba(245,240,232,0.75)" },
      "muted":       { "$type": "color", "$value": "#9A8C7E", "$description": "輔助/說明文字" },
      "link":        { "$type": "color", "$value": "#C8BFB0", "$description": "頁尾連結文字" },
      "accent":      { "$type": "color", "$value": "#E4A93C", "$description": "金色強調文字（標籤、金額、步驟）" },
      "strong":      { "$type": "color", "$value": "#FFFFFF", "$description": "最高對比標題（Hero）" },
      "inverse":     { "$type": "color", "$value": "#0A0A0A", "$description": "金色按鈕上的深色文字" },
      "placeholder": { "$type": "color", "$value": "#F5F0E880", "$description": "輸入框 placeholder，rgba(245,240,232,0.5)" },
      "on-gold":     { "$type": "color", "$value": "#C9922A", "$description": "透明底上的金色文字（Ghost 按鈕）" }
    },

    "border": {
      "default": { "$type": "color", "$value": "#C9922A2E", "$description": "預設邊框/分隔線，rgba(201,146,42,0.18)" },
      "subtle":  { "$type": "color", "$value": "#C9922A38", "$description": "頁首/頁尾分隔線，rgba(201,146,42,0.22)" },
      "strong":  { "$type": "color", "$value": "#C9922A47", "$description": "卡片邊框，rgba(201,146,42,0.28)" },
      "badge":   { "$type": "color", "$value": "#C9922A66", "$description": "chip/badge 邊框，rgba(201,146,42,0.4)" },
      "ghost":   { "$type": "color", "$value": "#C9922A8C", "$description": "Ghost 按鈕邊框，rgba(201,146,42,0.55)" },
      "active":  { "$type": "color", "$value": "#C9922A", "$description": "選中/focus 邊框（實心金）" }
    },

    "brand": {
      "gold":       { "$type": "color", "$value": "#C9922A", "$description": "品牌主色" },
      "gold-light": { "$type": "color", "$value": "#E4A93C", "$description": "品牌亮金" }
    },

    "status": {
      "success-text":   { "$type": "color", "$value": "#4ADE80", "$description": "成功文字" },
      "success-bg":     { "$type": "color", "$value": "#1665342E", "$description": "成功底，rgba(22,101,52,0.18)" },
      "success-border": { "$type": "color", "$value": "#22C55E4D", "$description": "成功邊框，rgba(34,197,94,0.3)" },
      "danger":         { "$type": "color", "$value": "#C03A2B", "$description": "危險/客滿" },
      "warning-text":   { "$type": "color", "$value": "#C9922A", "$description": "提醒文字/圖示（沿用金色）" },
      "warning-bg":     { "$type": "color", "$value": "#C9922A14", "$description": "提醒底，rgba(201,146,42,0.08)" },
      "warning-border": { "$type": "color", "$value": "#C9922A47", "$description": "提醒邊框，rgba(201,146,42,0.28)" }
    }
  },

  "gradient": {
    "gold": {
      "$type": "gradient",
      "$description": "金色按鈕漸層（約 170deg）。實心端 gold-500，中段 gold-400。",
      "$value": [
        { "color": "#C9922A", "position": 0 },
        { "color": "#E4A93C", "position": 0.6 },
        { "color": "#C9922A", "position": 1 }
      ]
    }
  },

  "font": {
    "family": {
      "serif": { "$type": "fontFamily", "$value": ["Noto Serif TC", "serif"], "$description": "標題/展示字（餐廳名、頁面標題）" },
      "sans":  { "$type": "fontFamily", "$value": ["Noto Sans TC", "system-ui", "sans-serif"], "$description": "內文/介面字（預設）" }
    },
    "weight": {
      "light":    { "$type": "fontWeight", "$value": 300 },
      "regular":  { "$type": "fontWeight", "$value": 400 },
      "medium":   { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold":     { "$type": "fontWeight", "$value": 700 },
      "black":    { "$type": "fontWeight", "$value": 900 }
    }
  },

  "typography": {
    "$description": "文字樣式組合 token。命名依用途。size/lineHeight 單位 px。",
    "display": { "$type": "typography", "$value": { "fontFamily": "Noto Serif TC", "fontWeight": 700, "fontSize": "32px", "lineHeight": "44px", "letterSpacing": "0.64px" }, "$description": "Hero 餐廳名" },
    "h1":      { "$type": "typography", "$value": { "fontFamily": "Noto Serif TC", "fontWeight": 700, "fontSize": "28px", "lineHeight": "36px", "letterSpacing": "0" }, "$description": "頁面主標" },
    "h2":      { "$type": "typography", "$value": { "fontFamily": "Noto Serif TC", "fontWeight": 600, "fontSize": "18px", "lineHeight": "27px", "letterSpacing": "0" }, "$description": "區塊標題" },
    "h3":      { "$type": "typography", "$value": { "fontFamily": "Noto Serif TC", "fontWeight": 600, "fontSize": "16px", "lineHeight": "24px", "letterSpacing": "0" }, "$description": "卡片標題" },
    "body-lg": { "$type": "typography", "$value": { "fontFamily": "Noto Sans TC", "fontWeight": 500, "fontSize": "16px", "lineHeight": "26px", "letterSpacing": "0" }, "$description": "大內文" },
    "body":    { "$type": "typography", "$value": { "fontFamily": "Noto Sans TC", "fontWeight": 400, "fontSize": "14px", "lineHeight": "21px", "letterSpacing": "0" }, "$description": "預設內文" },
    "body-sm": { "$type": "typography", "$value": { "fontFamily": "Noto Sans TC", "fontWeight": 400, "fontSize": "13px", "lineHeight": "20px", "letterSpacing": "0" }, "$description": "小內文/說明" },
    "caption": { "$type": "typography", "$value": { "fontFamily": "Noto Sans TC", "fontWeight": 400, "fontSize": "12px", "lineHeight": "18px", "letterSpacing": "0" }, "$description": "輔助說明" },
    "overline":{ "$type": "typography", "$value": { "fontFamily": "Noto Sans TC", "fontWeight": 900, "fontSize": "12px", "lineHeight": "18px", "letterSpacing": "2.4px", "textTransform": "uppercase" }, "$description": "頁尾英文標語" },
    "label":   { "$type": "typography", "$value": { "fontFamily": "Noto Sans TC", "fontWeight": 500, "fontSize": "14px", "lineHeight": "21px", "letterSpacing": "0" }, "$description": "表單欄位標籤" },
    "btn-lg":  { "$type": "typography", "$value": { "fontFamily": "Noto Sans TC", "fontWeight": 600, "fontSize": "20px", "lineHeight": "29px", "letterSpacing": "0" }, "$description": "大按鈕文字" },
    "btn":     { "$type": "typography", "$value": { "fontFamily": "Noto Sans TC", "fontWeight": 600, "fontSize": "16px", "lineHeight": "23px", "letterSpacing": "0" }, "$description": "按鈕文字" },
    "btn-sm":  { "$type": "typography", "$value": { "fontFamily": "Noto Sans TC", "fontWeight": 600, "fontSize": "15px", "lineHeight": "22px", "letterSpacing": "0" }, "$description": "小按鈕文字" }
  },

  "space": {
    "$description": "間距量表，4px 基準。命名 space-{階}。off-scale 值（如 15/25）請優先套最接近的階；元件內距詳見 README 元件規範。",
    "0":  { "$type": "dimension", "$value": "0px" },
    "1":  { "$type": "dimension", "$value": "4px" },
    "1_5":{ "$type": "dimension", "$value": "6px" },
    "2":  { "$type": "dimension", "$value": "8px" },
    "2_5":{ "$type": "dimension", "$value": "10px" },
    "3":  { "$type": "dimension", "$value": "12px" },
    "3_5":{ "$type": "dimension", "$value": "14px" },
    "4":  { "$type": "dimension", "$value": "16px" },
    "5":  { "$type": "dimension", "$value": "20px" },
    "6":  { "$type": "dimension", "$value": "24px" },
    "8":  { "$type": "dimension", "$value": "32px" },
    "10": { "$type": "dimension", "$value": "40px" },
    "14": { "$type": "dimension", "$value": "56px" },
    "16": { "$type": "dimension", "$value": "64px" }
  },

  "radius": {
    "$description": "圓角。命名 radius-{尺寸}。",
    "xs":   { "$type": "dimension", "$value": "2px",   "$description": "連結 focus" },
    "sm":   { "$type": "dimension", "$value": "6px",   "$description": "圖示按鈕/chip/返回鍵" },
    "md":   { "$type": "dimension", "$value": "8px",   "$description": "輸入框/按鈕/時段/notice" },
    "lg":   { "$type": "dimension", "$value": "12px",  "$description": "卡片/面板" },
    "full": { "$type": "dimension", "$value": "9999px","$description": "圓形（頭像/單選/日曆日）" }
  },

  "borderWidth": {
    "1": { "$type": "dimension", "$value": "1px", "$description": "預設邊框" },
    "2": { "$type": "dimension", "$value": "2px", "$description": "強調圓框（狀態圖示）" }
  },

  "shadow": {
    "card": { "$type": "shadow", "$value": { "offsetX": "0px", "offsetY": "8px", "blur": "48px", "spread": "0px", "color": "#00000099" }, "$description": "Hero 主卡，rgba(0,0,0,0.6)" },
    "md":   { "$type": "shadow", "$value": { "offsetX": "0px", "offsetY": "4px", "blur": "32px", "spread": "0px", "color": "#00000080" }, "$description": "一般卡片，rgba(0,0,0,0.5)" },
    "sm":   { "$type": "shadow", "$value": { "offsetX": "0px", "offsetY": "4px", "blur": "24px", "spread": "0px", "color": "#00000080" }, "$description": "小卡片，rgba(0,0,0,0.5)" }
  }
}
